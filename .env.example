# Copy to .env and fill in. .env is git-ignored — never commit it.

# ====================================================
# LLM PROVIDER
# ====================================================
# groq (cloud, needs a key) or ollama (local, needs Ollama running)
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=

# When LLM_PROVIDER=ollama, Ollama must be running locally.
# ollama pull llama3.2:3b
# The model name is a constant in llm/ollama_provider.py,
# not an environment variable.

# ====================================================
# API
# ====================================================
# REQUIRED. The service refuses to start without it, because
# every endpoint needs one. Do not ship an open instance.
API_KEY=
API_KEY_HEADER=X-API-Key

API_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

API_DATASET_PATH=data/sample_sales.xlsx
API_ANALYTICS_DB_PATH=data/sales.db
API_CHAT_DB_URL=sqlite:///chat_history.db
API_DOCUMENTS_DIR=documents
API_DATASET_UPLOAD_DIR=data/uploads
API_REPORTS_DIR=reports

# ====================================================
# HARDENING
# ====================================================
# 10 MB
API_MAX_DATASET_UPLOAD_BYTES=10485760
API_MAX_DOCUMENT_UPLOAD_BYTES=10485760
API_ANALYSIS_TIMEOUT_SECONDS=120

# INFO | DEBUG
LOG_LEVEL=INFO