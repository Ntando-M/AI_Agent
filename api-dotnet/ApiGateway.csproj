<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ae7d2fd0-6f94-4303-8c23-50084d0525cc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!--
    The SDK's default glob is **/*.cs, which reaches into the
    nested ApiGateway.Tests folder and compiles its generated
    obj/ files a second time. The result is a wall of
    CS0579 "Duplicate attribute" errors that look like a
    corrupt SDK install. Excluding the folder explicitly is the
    documented fix.
  -->
  <ItemGroup>
    <Compile Remove="ApiGateway.Tests\**" />
    <EmbeddedResource Remove="ApiGateway.Tests\**" />
    <None Remove="ApiGateway.Tests\**" />
  </ItemGroup>

</Project>
