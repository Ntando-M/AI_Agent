# Environment variables
#
# .env holds real keys and must never be committed. .env.example
# is the documented template and contains no secrets, so it IS
# tracked - the README quick start tells you to copy it.
.env
.env.*
!.env.example

# Any stray copy of a secrets file, whatever it is called.
*.backup
secrets.json

venv/
.venv/
env/

# Database files

chat_history.db
data/sales.db

# Generated analysis output

charts/
outputs/
reports/

# Datasets uploaded through the API. User data, not source.
# The directory is created on demand by the API, so it does
# not need to exist in the repository.
data/uploads/

chroma_db/*
!chroma_db/.gitkeep

# Python files
__pycache__/
*.py[cod]
*$py.class

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db


#Api bin and obj files
bin/
obj/
api-dotnet/bin/
api-dotnet/obj/

# Agent scratch: plans and working notes. Not project source.
.hermes/
